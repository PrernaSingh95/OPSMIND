{
  "name": "opsmind-ai",
  "version": "1.0.0",
  "description": "OpsMind AI - Autonomous Business Operations Intelligence Platform",
  "scripts": {
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install-all": "npm install ; npm --prefix server install ; npm --prefix client install",
    "seed": "npm --prefix server run seed",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build"
  },
  "keywords": ["ai-agents", "operations", "rag", "mern", "workflow-automation"],
  "author": "OpsMind Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
